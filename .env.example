# Copy to .env (git-ignored) and fill in.
PORT=3000
NODE_ENV=development

# Any PostgreSQL 14+ (local, Neon, Supabase-as-plain-Postgres, ...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bharosa
# Set to true for hosted databases that require TLS (Neon, Supabase, Render, ...)
DATABASE_SSL=false

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=change-me-access
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Run nightly taste jobs inside the API process (turn off if you run them elsewhere)
ENABLE_JOBS=true

# Browser origins allowed by CORS, comma separated. Leave empty: the mobile app does not use CORS.
CORS_ORIGINS=
# Interactive docs at /docs. Defaults to on in development and off in production.
SWAGGER_ENABLED=true

# Public base URL for uploaded photos (CDN or bucket). Empty until storage is chosen.
MEDIA_BASE_URL=

# Photos are stored here and served at /media until an object-storage provider is chosen.
UPLOAD_DIR=uploads
